<div class="relative w-full min-h-[700px] lg:h-[850px] overflow-hidden bg-slate-900">

  {# 1. Background Image #}
  {% if node.field_image.entity %}
    <img src="{{ file_url(node.field_image.entity.uri.value) }}" 
         class="absolute inset-0 w-full h-full object-cover z-0" 
         alt="{{ label }}">
  {% endif %}

  {# 2. Dark Overlay Scrim #}
  <div class="absolute inset-0 bg-black/50 z-10"></div>

  {# 3. Main Hero Grid #}
  <div class="absolute inset-0 z-20 grid grid-cols-1 lg:grid-cols-3 gap-8 p-6 md:p-12 lg:p-20">
    
    {# LEFT: Article Headline & Summary (2/3 width on desktop) #}
    <div class="lg:col-span-2 flex items-center">
      <div class="border-l-8 border-white pl-6 md:pl-10 lg:pl-14 py-4">
        <h1 class="text-white font-[950] text-5xl md:text-7xl lg:text-8xl uppercase leading-[0.9] tracking-tighter drop-shadow-2xl mb-6">
          {{ label }}
        </h1>
        <p class="text-gray-100 font-light italic text-xl md:text-2xl lg:text-3xl leading-relaxed max-w-2xl tracking-wide">
          {% if node.body.summary %}
            {{ node.body.summary|striptags }}
          {% else %}
            {{ node.body.value|striptags|slice(0, 180) }}...
          {% endif %}
        </p>
      </div>
    </div>

    {# RIGHT: Subtle Ad Stack (1/3 width on desktop) #}
    <div class="flex flex-col justify-end gap-4 lg:pb-4">
      
      {% for i in 1..3 %}
      <div class="bg-white/10 backdrop-blur-md border-l-2 border-white/30 p-6 text-white group hover:bg-white/20 transition-all duration-300">
        <span class="text-[10px] uppercase tracking-widest text-white/50 mb-2 block">Sponsored</span>
        <h3 class="font-bold text-lg leading-snug mb-1">Local Partner Heading {{ i }}</h3>
        <p class="text-sm text-gray-200 font-light">Supporting local aviation and the Minnesota flyer community.</p>
        <div class="mt-3 text-xs font-bold uppercase tracking-tighter border-b border-transparent group-hover:border-white inline-block cursor-pointer">Learn More →</div>
      </div>
      {% endfor %}

    </div>

  </div>
</div>

  {# Main Content Area #}
<article class="max-w-4xl mx-auto px-6 py-16 lg:py-24">
<div class="prose lg:prose-xl max-w-none">
  
</div>  
  <div class="prose prose-slate lg:prose-xl 
              prose-headings:font-[950] prose-headings:uppercase prose-headings:tracking-tighter
              prose-p:leading-relaxed prose-p:text-slate-700
              prose-a:text-blue-600 prose-a:no-underline hover:prose-a:border-b-2 border-blue-600
              prose-blockquote:border-l-8 prose-blockquote:border-blue-600 prose-blockquote:italic prose-blockquote:font-light prose-blockquote:text-2xl
              prose-img:rounded-2xl prose-img:shadow-2xl
              first-letter:text-7xl first-letter:font-[950] first-letter:mr-3 first-letter:float-left first-letter:leading-[0.8] first-letter:text-slate-900">
    
    {{ content.body }}
    
  </div>

  {# Tags / Taxonomy section #}
  {% if content.field_tags %}
    <div class="mt-16 pt-8 border-t border-slate-200">
      <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Filed Under</h4>
      <div class="flex gap-2">
        {{ content.field_tags }}
      </div>
    </div>
  {% endif %}
</article>