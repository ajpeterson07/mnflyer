{#
/**
 * @file
 * Theme override to display a single page.
 */
#}
<div id="mn-flyer-theme">
<header role="banner" class="w-full">
  {# Site Branding Banner #}
  <div class="w-full bg-gradient-to-b from-slate-950 via-slate-900 to-slate-800 flex flex-col justify-center items-center text-center px-4 py-4 md:py-6 shadow-xl border-b border-white/5">
    
    {# 1. The Sherm Booen Legacy Tagline #}
    <span class="text-white font-medium text-[10px] md:text-xs uppercase tracking-[0.25em] md:tracking-[0.4em] mb-1 opacity-80 drop-shadow-sm">
      Continuing the Legacy of Sherm Booen
    </span>

    {# 2. Wrapped in a link to home #}
    <a href="{{ front_page }}" class="flex items-start text-white select-none hover:opacity-90 transition-opacity no-underline hover:cursor-pointer">
      <span class="font-serif font-black text-4xl md:text-5xl lg:text-6xl leading-[0.8] tracking-tighter">
        M
      </span>
      <div class="flex flex-col items-start pl-0.5">
        <span class="font-serif font-bold text-2xl md:text-3xl lg:text-4xl leading-[0.85] tracking-tight border-b-2 md:border-b-4 border-white pb-0.5 uppercase">
          innesota
        </span>
      </div>
      <span class="font-serif font-light text-2xl md:text-3xl lg:text-4xl leading-[0.85] tracking-tight uppercase pl-2 md:pl-4">
        Flyer
      </span>
    </a>
  </div>
</header>

{# Alpine.js Overlay Menu Nav #}
<div class="w-full bg-slate-800 border-b border-white/10 shadow-md">
  <div x-data="{ open: false }" class="relative max-w-7xl mx-auto px-4">
    
    <button @click="open = true" class="inline-flex items-center gap-4 text-white font-[950] text-2xl uppercase tracking-tighter leading-none bg-slate-800 hover:bg-slate-700 px-12 py-4 transition-all duration-300 cursor-pointer border-x border-white/10 hover:scale-105 whitespace-nowrap min-w-max group">
      <span>Explore</span>
      <svg class="h-4 w-4 shrink-0 transform text-slate-400 transition-transform duration-300 ease-out group-hover:translate-x-2 group-hover:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <template x-teleport="body">
      <div x-show="open" 
           x-transition:enter="transition ease-out duration-300"
           x-transition:enter-start="opacity-0"
           x-transition:enter-end="opacity-100"
           x-transition:leave="transition ease-in duration-200"
           x-transition:leave-start="opacity-100"
           x-transition:leave-end="opacity-0"
           class="fixed inset-0 z-[100] flex items-center justify-center p-6 lg:p-20"
           style="display: none;">
        <div class="absolute inset-0 bg-slate-900/90 backdrop-blur-xl" @click="open = false"></div>

        <button @click="open = false" class="absolute top-10 right-10 text-white hover:rotate-90 transition-transform duration-300">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>

        <div class="relative w-full max-w-6xl grid grid-cols-1 md:grid-cols-2 gap-16 lg:gap-32 max-h-[85vh] overflow-y-auto pr-2">
          
         {# Column 1: Dynamic Taxonomy Departments #}
<div class="bg-slate-900/40 p-6 rounded-xl flex flex-col h-full max-h-[70vh]">
  <h2 class="text-blue-500 text-xs font-black uppercase tracking-[0.3em] mb-8 border-b border-blue-500/30 pb-4">
    Departments
  </h2>
  
  {% if page.explore_departments %}
    {# Switched from carousel to a static 1-column grid #}
    <div class="nav-links">
      {# Tailwind classes applied to the direct links #}
      <div>
        {{ page.explore_departments }}
      </div>
    </div>
  {% else %}
    <p class="text-slate-500 text-sm italic">No departments to display.</p>
  {% endif %}
</div>

          {# Column 2: Recent Stories #}
          <div class="flex flex-col justify-between h-full bg-slate-900/40 p-6 rounded-xl">
            <div>
              <h2 class="text-slate-400 text-xs font-black uppercase tracking-[0.3em] mb-8 border-b border-slate-700 pb-4">
                Recent Stories
              </h2>
              <div class="text-white">
                {{ drupal_block('views_block:recent_stories-recent_stories') }}
              </div>
            </div>

            <div class="mt-20 md:mt-auto pt-8 border-t border-slate-800/60">
              <p class="text-slate-500 text-xs font-bold uppercase tracking-widest leading-loose">
                Minnesota Flyer Magazine<br>
                Continuing the legacy of Sherm Booen<br>
                Serving Midwest Aviation Since 1960
              </p>
            </div>
          </div>
        </div>
      </div>
    </template>
  </div>
</div>

{{ page.header }}
</header>

{% if page.primary_menu or page.secondary_menu or page.breadcrumb %}
<div class="w-full max-w-7xl mx-auto px-4 mt-2">
  {{ page.primary_menu }}
  {{ page.secondary_menu }}
  {{ page.breadcrumb }}
</div>
{% endif %}

{{ page.highlighted }}
{{ page.help }}

<main role="main" class="w-full max-w-7xl mx-auto px-4 py-8 flex-grow">
  <a id="main-content" tabindex="-1"></a>
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    
    {% if page.sidebar_first %}
      <aside class="lg:col-span-1 order-2 lg:order-1" role="complementary">
        {{ page.sidebar_first }}
      </aside>
    {% endif %}

    <div class="layout-content order-1 {% if page.sidebar_first and page.sidebar_second %}lg:col-span-2{% elseif page.sidebar_first or page.sidebar_second %}lg:col-span-3{% else %}lg:col-span-4{% endif %}">
      {{ page.content }}
    </div>

    {% if page.sidebar_second %}
      <aside class="lg:col-span-1 order-3" role="complementary">
        {{ page.sidebar_second }}
      </aside>
    {% endif %}
  </div>
</main>

{# Bottom Subscription Fixed Overlay #}
<div class="fixed bottom-0 left-0 right-0 z-50 w-full border-t border-slate-200 bg-white/95 p-4 shadow-xl backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4">
    <div>
      <h4 class="text-sm font-semibold text-slate-900">Subscriptions</h4>
      <p class="text-xs text-slate-600">Annual subscription plans</p>
    </div>
    <div class="flex items-center gap-6">
      <span class="text-xl font-bold text-slate-900">1-year, 2-year rates</span>
      <a href="/subscribe" class="text-sm font-semibold text-slate-900 hover:text-blue-700 transition-colors underline decoration-slate-400 underline-offset-4">
        Complete your subscription
      </a>
    </div>
  </div>
</div>

{% if page.footer %}
<footer role="contentinfo" class="w-full bg-slate-900 text-white py-12 mt-auto">
  <div class="max-w-7xl mx-auto px-4">
    {{ page.footer }}
  </div>
</footer>
{% endif %}

</div>
</div>
