{# 
  Custom Views Fields Override for 'front' view
  Matches full article styling with dynamic story background and ad stacks
#}

{# 1. Extract the raw image URL from the image field to use as a background #}
{% set background_image_url = fields.field_image.content|striptags|trim %}

<div class="relative w-full min-h-[500px] rounded-3xl overflow-hidden shadow-2xl border border-white/10 mb-12 bg-slate-950 text-white group">
  
  {# 2. The Dynamic Blurry Story Background #}
  <div class="absolute inset-0 bg-cover bg-center opacity-30 transition-transform duration-700 group-hover:scale-100" 
       style="background-image: url('{{ background_image_url }}');">
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent opacity-80"></div>

  {# 3. Main Master Layout Grid (Matches Full Article Layout) #}
  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 p-6 md:p-10 items-stretch h-full">
    
    {# LEFT COLUMN: The Story Content (Spans 8 cols on desktop) #}
    <div class="lg:col-span-8 flex flex-col justify-center space-y-6">
      
      {# Featured Tag #}
      <span class="self-start px-3 py-1 bg-blue-600/30 text-blue-400 text-xs font-bold uppercase tracking-widest rounded-full border border-blue-500/20">
        Latest Issue Feature
      </span>

      {# Article Title #}
      <h1 class="font-serif font-black text-4xl md:text-5xl lg:text-6xl tracking-tight leading-tight text-white drop-shadow-md">
        {{ fields.title.content }}
      </h1>

      {# Body Summary #}
      <div class="text-slate-300 text-lg md:text-xl font-light leading-relaxed max-w-3xl">
        {{ fields.body.content }}
      </div>

      {# Read Story Action Link #}
      <div class="pt-4">
        {{ fields.view_node.content }} 
      </div>
    </div>

    {# RIGHT COLUMN: The Integrated Desktop Ad Stack (Spans 4 cols on desktop) #}
    <div class="lg:col-span-4 flex flex-col justify-center items-center lg:items-end border-t lg:border-t-0 lg:border-l border-white/10 pt-6 lg:pt-0 lg:pl-8">
      
      {# Ad Placeholder Container — Replace wrapper or contents with your block tokens #}
      <div class="w-full max-w-[300px] aspect-[4/3] lg:aspect-square bg-slate-900/60 backdrop-blur-sm border border-white/5 rounded-2xl flex flex-col items-center justify-center p-4 text-center shadow-inner">
        <span class="text-slate-500 text-xs font-semibold tracking-widest uppercase mb-2">Advertisement</span>
        <div class="text-slate-400 text-sm font-light">
          {# If pulling your ad from a block variable, print it here, e.g., {{ page.sidebar_ad }} #}
          Commercial Slot Available
        </div>
      </div>

    </div>

  </div>
</div>