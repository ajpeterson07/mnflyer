{# 
  Custom Views Fields Override for 'front' view
  Matches full article styling with dynamic story background (No Ad Stack)
#}

{# 1. Extract the raw image URL from the image field to use as a background #}
{% set background_image_url = fields.field_image.content|striptags|trim %}

<div class="relative w-full max-h-[500px] rounded-3xl overflow-hidden shadow-2xl border border-white/10 mb-12 bg-slate-950 text-white group">
  
  {# 2. The Dynamic Blurry Story Background #}
  <div class="absolute inset-0 bg-cover bg-center opacity-90 transition-transform duration-700 group-hover:scale-100" 
       style="background-image: url('{{ background_image_url }}');">
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent opacity-80"></div>

  {# 3. Main Master Layout Grid (Full Width) #}
  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 p-6 md:p-10 items-stretch h-full">
    
    {# LEFT COLUMN: The Story Content (Now spans all 12 columns) #}
    <div class="lg:col-span-12 flex flex-col justify-center space-y-6">
      
      {# Featured Tag #}
      <span class="self-start px-3 py-1 bg-blue-600/30 text-white-400 text-xs font-bold uppercase tracking-widest rounded-full border border-blue-500/20">
        Latest Issue Feature
      </span>

      {# Article Title #}
      <h1 class="font-serif font-black text-4xl md:text-5xl lg:text-6xl tracking-tight leading-tight text-white drop-shadow-md [&_a]:text-white [&_a]:hover:text-white">
        {{ fields.title.content }}
      </h1>

      {# Body Summary #}
      <div class="text-slate-300 text-lg md:text-xl font-light leading-relaxed max-w-3xl">
        {{ fields.body.content }}
      </div>

      {# Read Story Action Link #}
      <div class="pt-4">
        {{ fields.view_node.content }} 
      </div>
    </div>

  </div>
</div>